# Consolidated .gitignore for AVAR Project

# Dependencies (matches in any directory, root, frontend, backend)
node_modules/

# Production build outputs
/frontend/dist/
/frontend/dist-ssr/
/frontend/.output/
/frontend/.vinxi/
/frontend/.tanstack/
/frontend/.nitro/
/frontend/.wrangler/
/frontend/.dev.vars

# Local Environment Secret Files (matches in any directory)
.env
*.local
.dev.vars

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# IDEs, Editors and System Files
.vscode/
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
